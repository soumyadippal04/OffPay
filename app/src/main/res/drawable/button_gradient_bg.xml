<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action button on the payment result screen. Brand blue (same
     family as the status circle's success gradient) rather than a status
     color: the outcome is conveyed by the circle/heading/amount, and the
     action button stays consistent across success and failure screens. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <gradient
        android:startColor="#A8CFFF"
        android:centerColor="#86B5FF"
        android:endColor="#76A5F5"
        android:angle="270" />
    <stroke android:width="1dp" android:color="#99FFFFFF" />
</shape>
