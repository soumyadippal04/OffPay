<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qrRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scanner Frame: four rounded corner brackets -->
    <FrameLayout
        android:id="@+id/scannerOverlay"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:clipChildren="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|start"
            android:rotation="0"
            android:src="@drawable/qr_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|end"
            android:rotation="90"
            android:src="@drawable/qr_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:rotation="180"
            android:src="@drawable/qr_corner"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|start"
            android:rotation="270"
            android:src="@drawable/qr_corner"
            android:contentDescription="@null" />

        <!-- Kept for code refs; not shown in the minimal design -->
        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:visibility="gone"
            android:background="@drawable/scan_line_gradient" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvCameraHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:text="@string/qr_camera_off_gallery_hint"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:lineSpacingExtra="6dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Camera and permission-free photo picker controls. -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/creatorCredit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bottom_action_button_bg"
            android:src="@drawable/ic_flash_off"
            android:scaleType="centerInside"
            android:padding="18dp"
            android:contentDescription="@string/qr_torch"
            app:tint="@color/white" />

        <!-- Same 64dp box, same background and padding as the torch so the
             pair reads as one symmetric group centred on the screen. -->
        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/bottom_action_button_bg"
            android:src="@drawable/ic_gallery"
            android:scaleType="centerInside"
            android:padding="18dp"
            android:contentDescription="@string/qr_pick_from_gallery"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Close scanner; this does not terminate an external bank call. -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bottom_action_button_bg"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="@string/qr_close_scanner"
            app:tint="@color/white" />

    </FrameLayout>

    <!-- A static, scrollable guide remains after handoff; OffPay cannot observe the bank outcome. -->
    <ScrollView
        android:id="@+id/instructionsBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnTerminate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/instructions_card_bg">

            <TextView
                android:id="@+id/instructionsHeaderInitial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_handoff_title"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:id="@+id/instructionsExpanded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_handoff_step_start"
                    android:textSize="15sp"
                    android:textColor="@color/divider_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_handoff_step_payee"
                    android:textSize="15sp"
                    android:textColor="@color/divider_dark"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_handoff_step_review"
                    android:textSize="15sp"
                    android:textColor="@color/divider_dark"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/divider_dark"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </ScrollView>

    <!-- Hidden: Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Invalid-scan banner: sits OVER the live preview so a bad QR never
         blanks the camera. Auto-hides and scanning continues. -->
    <TextView
        android:id="@+id/tvScanError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@drawable/scan_error_banner_bg"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnTerminate"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_gradient_bg"
        android:backgroundTint="@null"
        android:text="@string/action_done"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:textColor="@color/brand_on_gradient"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        android:contentDescription="@string/action_done"
        app:layout_constraintBottom_toTopOf="@id/creatorCredit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/creatorCredit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center"
        android:background="@drawable/creator_credit_scrim"
        android:text="@string/creator_credit"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
